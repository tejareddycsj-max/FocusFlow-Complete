generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  name              String
  email             String         @unique
  passwordHash      String?
  studentId         String?
  department        String         @default("Computer Science")
  academicYear      String         @default("3rd Year")
  studyGoal         Float          @default(4.0)
  
  // Gamification
  streak            Int            @default(7)
  xp                Int            @default(650)
  level             Int            @default(4)
  
  // Timer Settings
  pomoMinutes       Int            @default(25)
  shortBreakMinutes Int            @default(5)
  longBreakMinutes  Int            @default(15)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tasks             Task[]
  sessions          StudySession[]
  chatMessages      ChatMessage[]
}

model Task {
  id           String   @id @default(uuid())
  userId       String
  title        String
  subject      String
  priority     String   @default("Medium") // High, Medium, Low
  deadline     String
  day          String?
  status       String   @default("pending") // pending, completed
  rating       Int      @default(3) // 1 to 5 stars
  plannedHours Float    @default(2.0)
  actualHours  Float    @default(0.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudySession {
  id              String   @id @default(uuid())
  userId          String
  subject         String   @default("General Study")
  mode            String   @default("pomodoro") // pomodoro, shortBreak, longBreak
  durationSeconds Int
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  sender    String   // user, bot
  message   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
